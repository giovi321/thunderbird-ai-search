{
  "manifest_version": 2,
  "name": "AI Email Search",
  "description": "Semantic search over your email using local AI",
  "version": "1.1.1",
  "author": "Giovanni Crapelli",
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-email-search@giovannicrapelli.com",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "messagesRead",
    "storage",
    "tabs",
    "<all_urls>"
  ],
  "browser_action": {
    "default_title": "AI Email Search",
    "default_icon": {
      "16": "icons/search-16.svg",
      "32": "icons/search-32.svg"
    }
  },
  "commands": {
    "open-search": {
      "suggested_key": {
        "default": "Ctrl+Alt+S"
      },
      "description": "Open AI Email Search in a new tab"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options/options.html"
  },
  "icons": {
    "16": "icons/search-16.svg",
    "32": "icons/search-32.svg",
    "64": "icons/search-64.svg"
  }
}
